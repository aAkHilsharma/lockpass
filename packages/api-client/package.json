{
  "name": "@lockpass/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-dts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lockpass/crypto": "workspace:*",
    "@lockpass/domain": "workspace:*",
    "@lockpass/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
